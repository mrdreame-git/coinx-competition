# COINX environment
# -----------------
# Every variable here is optional. With none of them set, the app reads Binance
# USD-M futures and automatically falls back to Binance spot if that host cannot
# be reached:
#
#   futures   https://fapi.binance.com          wss://fstream.binance.com
#   spot      https://data-api.binance.vision   wss://data-stream.binance.vision
#
# Why the fallback exists: some networks block `*.binance.com` at the DNS level.
# On an Indonesian ISP those names resolve to a regulator landing page
# (lamanlabuh.aduankonten.id) and every request times out, while the real Binance
# servers stay reachable. Binance's public spot feed lives on the separate
# `*.binance.vision` domains, which those networks do not touch, so the app keeps
# working on live prices instead of showing an empty screen.
#
# Trade-off worth knowing: futures carries mark price, funding rate and open
# interest. Spot does not have those concepts, so on the fallback the app swaps
# those fields for spot equivalents (top of book, session range, fill count)
# rather than leaving dead placeholders. Everything else is identical.
#
# Leave a value blank to fall back to the public host.

# Force a market instead of detecting one: auto (default), futures, or spot.
# Pin this to skip detection entirely.
NEXT_PUBLIC_BINANCE_MARKET=auto

# Futures REST host: tickers, candles, depth, trades, funding, open interest.
NEXT_PUBLIC_BINANCE_FAPI=

# Futures WebSocket host: ticker, depth, trade, mark price and kline streams.
NEXT_PUBLIC_BINANCE_FSTREAM=

# Spot REST host, used automatically when futures is unreachable.
NEXT_PUBLIC_BINANCE_SPOT_API=

# Spot WebSocket host, paired with the above.
NEXT_PUBLIC_BINANCE_SPOT_STREAM=
